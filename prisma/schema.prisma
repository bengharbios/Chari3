generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
}

datasource db {
  provider        = "mysql"
  url             = env("DATABASE_URL")
  relationMode    = "prisma"
}

// ============================================
// USER & AUTH MODELS
// ============================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  phone           String?   @unique
  password        String?
  name            String
  nameEn          String?
  avatar          String?
  role            String    @default("buyer") // store, freelancer, supplier, logistics, buyer
  accountStatus   String    @default("incomplete") // incomplete, pending, active, rejected, suspended
  isActive        Boolean   @default(true)
  isVerified      Boolean   @default(false)
  phoneVerified   Boolean   @default(false)
  emailVerified   Boolean   @default(false)
  locale          String    @default("ar")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  store              Store?           @relation("StoreManager")
  sellerProfile      SellerProfile?
  logisticsProfile   LogisticsProfile?
  buyerProfile       BuyerProfile?
  addresses          Address[]
  notifications      Notification[]
  orders             Order[]          @relation("OrderBuyer")
  reviews            Review[]
  wallet             Wallet?
  staffOf            StoreStaff[]
  storeVerification  StoreVerification?
  freelancerVerification FreelancerVerification?
  supplierVerification  SupplierVerification?
  logisticsVerification LogisticsVerification?
  auditLogs          AuditLog[]
  categoryRequests   CategoryRequest[]
  debtReceipts       DebtPaymentReceipt[]
  subscriptions      Subscription[]
  invoices           Invoice[]
}

model Store {
  id            String    @id @default(cuid())
  name          String
  nameEn        String?
  slug          String    @unique
  description   String?
  logo          String?
  coverImage    String?
  isActive      Boolean   @default(true)
  rating        Float     @default(0)
  totalSales    Int       @default(0)
  commission    Float     @default(10)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  managerId     String    @unique
  manager       User      @relation("StoreManager", fields: [managerId], references: [id])

  packageId     String?
  package       SellerPackage? @relation(fields: [packageId], references: [id])

  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])

  level         Int      @default(1)
  totalCustomers Int     @default(0)
  totalEarnings  Float   @default(0)
  completionRate Float   @default(100)

  products      Product[]
  staff         StoreStaff[]

  shippingRates         String?   @db.LongText
  shippingIntegrations  String?   @db.LongText
  paymentDetails        String?   @db.LongText
  themeSettings         String?   @db.LongText

  addonMobileApp        Boolean  @default(false)
  addonWhatsAppSupport  Boolean  @default(false)
  addonAdvancedCRM      Boolean  @default(false)
  addonEchangoPOS       Boolean  @default(false)
  addonExtraPOSDevices  Int      @default(0)

  globalCoupons         Coupon[]  @relation("GlobalCouponOptInStores")
}

model StoreStaff {
  id        String   @id @default(cuid())
  role      String   @default("staff")
  joinedAt  DateTime @default(now())

  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@unique([storeId, userId])
}

model SellerProfile {
  id                  String    @id @default(cuid())
  storeName           String?
  storeNameEn         String?
  bio                 String?
  coverImage          String?
  logo                String?
  socialLinks         String    @default("{}")   // JSON: instagram, facebook, tiktok
  returnPolicy        String?
  shippingPolicy      String?

  // Performance metrics
  rating              Float     @default(0)
  totalSales          Int       @default(0)
  totalCustomers      Int       @default(0)
  totalEarnings       Float     @default(0)
  commissionPaid      Float     @default(0)
  completionRate      Float     @default(100) // %
  responseRate        Float     @default(100) // %
  avgResponseHours    Float     @default(24)
  challengePoints     Int       @default(0)

  // Level system
  level               Int       @default(1)
  levelUpdatedAt      DateTime?
  levelGraceUntil     DateTime? // Grace period before demotion

  packageId           String?
  package             SellerPackage? @relation(fields: [packageId], references: [id])

  categoryId          String?
  category            Category? @relation(fields: [categoryId], references: [id])

  paymentModel        String    @default("default") // default, centralized, decentralized, mixed

  isVerified          Boolean   @default(false)
  wantsUpgrade        Boolean   @default(false)
  upgradeRequestedAt  DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id])

  products            Product[]
  sellerReviews       SellerReview[]
  withdrawals         WithdrawalRequest[]

  shippingRates         String?   @db.LongText
  shippingIntegrations  String?   @db.LongText
  paymentDetails        String?   @db.LongText
  themeSettings         String?   @db.LongText

  addonMobileApp        Boolean  @default(false)
  addonWhatsAppSupport  Boolean  @default(false)
  addonAdvancedCRM      Boolean  @default(false)
  addonEchangoPOS       Boolean  @default(false)
  addonExtraPOSDevices  Int      @default(0)

  globalCoupons         Coupon[]  @relation("GlobalCouponOptInSellers")
}

// ============================================
// SELLER PACKAGE MODEL (Admin-controlled)
// ============================================

model SellerPackage {
  id                    String   @id @default(cuid())
  name                  String   // "مجاني", "أساسي", "محترف", "بريميوم"
  nameEn                String?
  description           String?
  price                 Float    @default(0)     // Monthly price
  commissionRate        Float    @default(10)    // % per sale
  maxProducts           Int      @default(5)
  maxMonthlyOrders      Int      @default(50)
  maxImagesPerProduct   Int      @default(3)
  hasVideoUpload        Boolean  @default(false)
  hasAnalytics          Boolean  @default(false)
  hasPromotedListing    Boolean  @default(false)
  hasCoupons            Boolean  @default(false)
  hasApiAccess          Boolean  @default(false)
  hasPrioritySupport    Boolean  @default(false)
  
  // Advanced features
  maxTeamMembers        Int      @default(1)
  hasCustomDomain       Boolean  @default(false)
  hasPixels             Boolean  @default(false)
  hasMultiCurrency      Boolean  @default(false)
  hasDataExport         Boolean  @default(false)
  maxLandingPages       Int      @default(0)

  hasEmailSupport       Boolean  @default(false)
  hasBusinessIntelligence Boolean @default(false)
  hasGA4                Boolean  @default(false)

  color                 String   @default("#6B7280")
  icon                  String   @default("Package")
  isActive              Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  sellers               SellerProfile[]
  stores                Store[]
  subscriptions         Subscription[]
}

// ============================================
// SELLER LEVEL MODEL (Admin-controlled, 1-10)
// ============================================

model SellerLevel {
  id                  String   @id @default(cuid())
  level               Int      @unique          // 1-10
  nameAr              String
  nameEn              String
  badge               String                    // emoji or label
  badgeColor          String   @default("#6B7280")
  minCustomers        Int      @default(0)
  minRating           Float    @default(0)
  minCompletionRate   Float    @default(0)      // %
  minResponseRate     Float    @default(0)      // %
  maxResponseHours    Int      @default(48)
  maxProducts         Int      @default(5)      // Product listing cap
  commissionDiscount  Float    @default(0)      // % discount on package commission
  bonusFeatures       String   @default("[]")   // JSON array of feature keys
  gracePeriodDays     Int      @default(180)    // Days before demotion
  searchBoost         Float    @default(1.0)    // Multiplier for search ranking
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ============================================
// SELLER REVIEW (separate from product review)
// ============================================

model SellerReview {
  id              String   @id @default(cuid())
  rating          Int                           // 1-5 overall
  speedRating     Int?                          // 1-5 speed
  qualityRating   Int?                          // 1-5 quality
  commRating      Int?                          // 1-5 communication
  comment         String?
  sellerReply     String?
  replyAt         DateTime?
  isApproved      Boolean  @default(true)

  sellerId        String
  seller          SellerProfile @relation(fields: [sellerId], references: [id])
  buyerId         String
  orderId         String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================
// PRODUCT VARIANT (color, size, etc.)
// ============================================

model ProductVariant {
  id          String   @id @default(cuid())
  name        String                            // "اللون", "المقاس"
  value       String                            // "أحمر", "XL"
  sku         String?
  price       Float?                            // Override product price if set
  comparePrice Float?                           // Slashed price for variant
  stock       Int      @default(0)
  image       String?
  swatchType  String?                           // "color", "image"
  swatchValue String?                           // Hex color code or custom image URL
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  productId   String
  product     Product  @relation(fields: [productId], references: [id])
}

// ============================================
// ADVERTISEMENT MODEL
// ============================================

model Advertisement {
  id          String   @id @default(cuid())
  title       String
  titleEn     String?
  imageUrl    String
  linkUrl     String?
  zone        String                            // hero, banner_top, banner_mid, sidebar, inline_products, category_header
  targetRole  String   @default("all")         // all, buyer, guest
  isActive    Boolean  @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  clicks      Int      @default(0)
  impressions Int      @default(0)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// SHIPPING METHOD MODEL
// ============================================

model ShippingMethod {
  id            String   @id @default(cuid())
  name          String                          // "شحن المنصة", "توصيل بالسائق", "استلام من المحل"
  nameEn        String?
  description   String?
  type          String                          // platform, self, pickup, partner
  basePrice     Float    @default(0)
  perKgPrice    Float    @default(0)
  freeAbove     Float?                          // Free shipping if order > X DZD
  estimatedDays String   @default("1-3")
  isActive      Boolean  @default(true)
  icon          String   @default("Truck")
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// PAYMENT METHOD MODEL
// ============================================

model GlobalPaymentMethod {
  id            String   @id @default(cuid())
  name          String                          // "الدفع عند الاستلام", "Tabby"
  nameEn        String?
  description   String?
  type          String                          // cod, credit_card, tabby, baridimob, bank_transfer, wallet
  icon          String   @default("CreditCard")
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  fee           Float    @default(0)            // E.g., COD fee
  configSchema  String?  @db.LongText           // JSON config
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// WITHDRAWAL REQUEST MODEL
// ============================================

model WithdrawalRequest {
  id            String   @id @default(cuid())
  amount        Float
  method        String                          // ccp, cib, bank_transfer, cash
  status        String   @default("pending")    // pending, approved, paid, rejected
  accountNumber String?                         // CCP/CIB/Bank account
  accountName   String?
  bankName      String?
  note          String?
  adminNote     String?
  processedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sellerId      String
  seller        SellerProfile @relation(fields: [sellerId], references: [id])
}

// ============================================
// CHALLENGE MODEL (Yassir-style)
// ============================================

model Challenge {
  id            String   @id @default(cuid())
  title         String
  titleEn       String?
  description   String?
  type          String                          // orders_count, revenue, rating
  targetValue   Float
  rewardType    String   @default("badge")     // badge, commission_discount, cash
  rewardValue   String                          // "خصم 5%", "شارة ذهبية"
  startsAt      DateTime
  endsAt        DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LogisticsProfile {
  id              String    @id @default(cuid())
  vehicleType     String    @default("motorcycle")
  plateNumber     String?
  licenseNumber   String?
  isOnline        Boolean   @default(false)
  currentLat      Float?
  currentLng      Float?
  rating          Float     @default(0)
  totalDeliveries Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])

  shipments       Shipment[]
}

model BuyerProfile {
  id            String    @id @default(cuid())
  totalOrders   Int       @default(0)
  totalSpent    Float     @default(0)
  loyaltyPoints Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])

  wishlist      WishlistItem[]
}

// ============================================
// PRODUCT & CATEGORY MODELS
// ============================================

model Category {
  id          String      @id @default(cuid())
  name        String
  nameEn      String?
  slug        String      @unique
  type        String      @default("product") // product, store, supplier, logistics
  icon        String?
  image       String?
  parentId    String?
  parent      Category?   @relation("CategoryTree", fields: [parentId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  children    Category[]  @relation("CategoryTree")
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  products        Product[]
  stores          Store[]
  sellerProfiles  SellerProfile[]

  coupons         Coupon[]  @relation("CouponCategories")
}

// ============================================
// CATEGORY REQUEST MODEL
// ============================================

model CategoryRequest {
  id          String   @id @default(cuid())
  nameAr      String
  nameEn      String?
  description String?
  type        String   @default("product") // product, store, supplier, logistics
  status      String   @default("pending") // pending, approved, rejected
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
}

model Product {
  id              String    @id @default(cuid())
  name            String
  nameEn          String?
  slug            String    @unique
  description     String?
  descriptionEn   String?
  price           Float
  comparePrice    Float?
  costPrice       Float?
  sku             String?
  barcode         String?
  images          String    @default("[]")
  videoUrl        String?
  specifications  String    @default("{}")
  status          String    @default("draft")
  stock           Int       @default(0)
  lowStock        Int       @default(5)
  weight          Float?
  dimensions      String?
  rating          Float     @default(0)
  reviewCount     Int       @default(0)
  soldCount       Int       @default(0)
  viewCount       Int       @default(0)
  isFeatured      Boolean   @default(false)
  brandId         String?
  volumeDiscounts String?   // JSON configuration for tier/bulk pricing
  urgencySettings String?   // JSON configuration for urgency trigger simulation
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  storeId         String?
  store           Store?    @relation(fields: [storeId], references: [id])
  sellerId        String?
  seller          SellerProfile? @relation(fields: [sellerId], references: [id])
  brand           Brand?    @relation(fields: [brandId], references: [id])

  orderItems      OrderItem[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  variants        ProductVariant[]

  coupons         Coupon[]  @relation("CouponProducts")
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  nameEn    String?
  logo      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
}

// ============================================
// ORDER & SHIPPING MODELS
// ============================================

model Order {
  id              String    @id @default(cuid())
  orderNumber     String    @unique
  status          String    @default("pending")
  paymentStatus   String    @default("pending")
  paymentMethod   String    @default("cod")
  subtotal        Float
  shippingCost    Float     @default(0)
  tax             Float     @default(0)
  discount        Float     @default(0)
  total           Float
  currency        String    @default("SAR")
  note            String?

  buyerId         String
  buyer           User      @relation("OrderBuyer", fields: [buyerId], references: [id])
  address         String
  couponId        String?
  shippingMethod  String    @default("standard")

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items           OrderItem[]
  shipments       Shipment[]
  reviews         Review[]
  statusHistory   OrderStatusHistory[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id])
  productId   String
  product     Product @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  productName String
  productImage String?
  price       Float
  quantity    Int
  total       Float
  status          String    @default("pending") // pending, shipped, delivered, cancelled, returned
  cancelReason    String?
  cancelledAt     DateTime?
}

model Shipment {
  id                String    @id @default(cuid())
  trackingNumber    String    @unique
  status            String    @default("pending")
  pickupAddress     String?
  deliveryAddress   String
  notes             String?

  orderId           String
  order             Order     @relation(fields: [orderId], references: [id])
  logisticsId       String
  logistics         LogisticsProfile @relation(fields: [logisticsId], references: [id])

  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  pickedUpAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  statusHistory     ShipmentStatusHistory[]
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  status    String
  note      String?
  createdAt DateTime @default(now())
}

model ShipmentStatusHistory {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id])
  status      String
  location    String?
  note        String?
  createdAt   DateTime @default(now())
}

// ============================================
// ADDRESS & WALLET MODELS
// ============================================

model Address {
  id          String   @id @default(cuid())
  label       String?
  fullName    String
  phone       String
  street      String
  city        String
  state       String?
  zipCode     String?
  country     String   @default("SA")
  isDefault   Boolean  @default(false)
  lat         Float?
  lng         Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model Wallet {
  id          String   @id @default(cuid())
  balance     Float    @default(0)
  debt        Float    @default(0)
  totalEarned Float    @default(0)
  totalSpent  Float    @default(0)
  currency    String   @default("SAR")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])

  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String   @id @default(cuid())
  type        String
  amount      Float
  balance     Float
  description String?
  referenceId String?
  createdAt   DateTime @default(now())

  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id])
}

// ============================================
// REVIEW & WISHLIST MODELS
// ============================================

model Review {
  id        String   @id @default(cuid())
  rating    Int
  title     String?
  comment   String?
  images    String   @default("[]")
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
}

model WishlistItem {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())

  buyerProfileId String
  buyerProfile   BuyerProfile @relation(fields: [buyerProfileId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([buyerProfileId, productId])
}

// ============================================
// NOTIFICATION MODEL
// ============================================

model Notification {
  id        String   @id @default(cuid())
  title     String
  titleEn   String?
  body      String
  bodyEn    String?
  type      String
  isRead    Boolean  @default(false)
  data      String?
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

// ============================================
// COUPON MODEL
// ============================================

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String    @default("percentage")
  value       Float
  minOrder    Float?
  maxDiscount Float?
  usageLimit  Int?
  usedCount   Int       @default(0)
  startsAt    DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  storeId     String?
  sellerId    String?

  // Extended features
  isGlobal       Boolean   @default(false)
  applicableTo   String    @default("all") // "all", "categories", "products"
  maxStoresLimit Int?      // Limit number of opted-in stores/merchants

  // Explicit Targets
  products       Product[] @relation("CouponProducts")
  categories     Category[] @relation("CouponCategories")

  // Global Opt-ins
  optInStores    Store[]   @relation("GlobalCouponOptInStores")
  optInSellers   SellerProfile[] @relation("GlobalCouponOptInSellers")
}

// ============================================
// SETTINGS MODEL
// ============================================

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.LongText
  type  String @default("string")
  group String @default("general")
}

// ============================================
// VERIFICATION & ONBOARDING MODELS
// ============================================

model StoreVerification {
  id                          String    @id @default(cuid())
  userId                      String    @unique
  user                        User      @relation(fields: [userId], references: [id])
  commercialRegisterNumber    String?
  commercialRegisterFile      String?   @db.LongText
  iban                        String?
  beneficiaryName             String?
  bankLetterFile              String?   @db.LongText
  managerIdFront              String?   @db.LongText
  managerIdBack               String?   @db.LongText
  verificationStatus          String    @default("pending") // pending, approved, rejected
  rejectionReasons            String?   // JSON array of reasons
  adminNotes                  String?
  reviewedBy                  String?
  reviewedAt                  DateTime?
  submittedAt                 DateTime  @default(now())
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
}

model FreelancerVerification {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id])
  freelanceDocFile      String?   @db.LongText // optional
  nationalIdFront       String?   @db.LongText
  nationalIdBack        String?   @db.LongText
  selfieUrls            String?   @db.LongText @default("[]") // JSON array
  livenessScore         Float?    // 0-1
  iban                  String?
  verificationStatus    String    @default("pending")
  rejectionReasons      String?   // JSON
  adminNotes            String?
  reviewedBy            String?
  reviewedAt            DateTime?
  submittedAt           DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model SupplierVerification {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id])
  commercialLicense     String?   @db.LongText
  importLicense         String?   @db.LongText
  iban                  String?
  productSamples        String?   @default("[]") // JSON
  verificationStatus    String    @default("pending")
  rejectionReasons      String?
  adminNotes            String?
  reviewedBy            String?
  reviewedAt            DateTime?
  submittedAt           DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model LogisticsVerification {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id])
  transportLicenseFile    String?   @db.LongText
  insuranceCertificateFile String?   @db.LongText
  numberOfVehicles        String?
  numberOfDrivers         String?
  iban                    String?
  verificationStatus      String    @default("pending")
  rejectionReasons        String?
  adminNotes              String?
  reviewedBy              String?
  reviewedAt              DateTime?
  submittedAt             DateTime  @default(now())
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  roleId      String?
  role        Role?    @relation(fields: [roleId], references: [id])
  adminId     String?
  action      String   // submitted, approved, rejected, edited, login, logout
  details     String?  // JSON
  ipAddress   String?
  createdAt   DateTime @default(now())
}

// ============================================
// ROLES & PERMISSIONS MODEL
// ============================================

model Role {
  id          String   @id @default(cuid())
  key         String   @unique  // e.g. admin, store_manager, seller
  nameAr      String   // Arabic display name
  nameEn      String   // English display name
  descriptionAr  String?  // Arabic description
  descriptionEn  String?  // English description
  color       String   @default("#6B7280") // Hex color for badges
  icon        String   @default("UserCircle") // Lucide icon name
  permissions String   @default("[]") // JSON array of permission keys
  isSystem    Boolean  @default(false) // System roles cannot be deleted
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  auditLogs   AuditLog[]
}

// ============================================
// ENTERPRISE ADMIN MODELS
// ============================================

model SystemSetting {
  key         String   @id // e.g., "site_colors", "commission_rate", "home_layout"
  value       Json     // Stores any type of data
  updatedBy   String   // ID of the admin who made the change
  updatedAt   DateTime @updatedAt
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminId     String
  action      String   // e.g., "UPDATE_SETTING", "IMPERSONATE_USER"
  targetId    String?  // ID of the target object
  details     Json?    // Before/After details
  ipAddress   String?
  createdAt   DateTime @default(now())
}

// ============================================
// GEOLOCATION / SHIPPING REGION MODELS
// ============================================

model Country {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., "DZ", "SA", "EG"
  nameAr      String
  nameEn      String
  currency    String   @default("DZD") // DZD, SAR, EGP
  phonePrefix String   @default("+213")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  states      State[]
}

model State {
  id           String   @id @default(cuid())
  code         String   // e.g., "16", "01" (Wilaya code)
  nameAr       String
  nameEn       String
  defaultPrice Float    @default(500)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  countryId    String
  country      Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)

  cities       City[]

  @@index([countryId])
}

model City {
  id        String   @id @default(cuid())
  nameAr    String
  nameEn    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stateId   String
  state     State    @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@index([stateId])
}

model ProductQA {
  id          String   @id @default(cuid())
  productId   String
  question    String
  answer      String?
  status      String   @default("pending") // pending, approved, rejected
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// ORDER STATUS SETTINGS (Admin-controlled)
// ============================================

model OrderStatusType {
  id          String   @id @default(cuid())
  key         String   @unique
  nameAr      String
  nameEn      String?
  color       String   @default("#6B7280")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// DEBT PAYMENT RECEIPT MODEL
// ============================================

model DebtPaymentReceipt {
  id            String   @id @default(cuid())
  amount        Float
  status        String   @default("pending")    // pending, approved, rejected
  receiptImage  String   @db.LongText           // Base64 or image URL
  adminNote     String?
  merchantNote  String?
  reviewedAt    DateTime?
  reviewedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String
  user          User     @relation(fields: [userId], references: [id])

  invoiceId     String?  // Optional link to the invoice this receipt pays

  @@index([userId])
}

// ============================================
// SUBSCRIPTION MODEL
// ============================================

model Subscription {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])

  packageId       String?
  package         SellerPackage? @relation(fields: [packageId], references: [id])

  // Status lifecycle: TRIAL → PENDING_PAYMENT → ACTIVE → EXPIRED → SUSPENDED → CANCELLED
  status          String   @default("TRIAL")  // TRIAL | PENDING_PAYMENT | ACTIVE | EXPIRED | SUSPENDED | CANCELLED
  billingCycle    String   @default("MONTHLY") // MONTHLY | ANNUAL

  startDate       DateTime @default(now())
  endDate         DateTime?   // Subscription expiry date
  trialEndsAt     DateTime?   // Trial period end
  renewedAt       DateTime?   // Last renewal date

  // Add-on flags (mirrors Store/SellerProfile for fast read)
  addons          String   @default("{}")  // JSON: { mobileApp, whatsapp, crm, pos, extraPos }
  addonsTotal     Float    @default(0)     // Monthly cost of add-ons
  totalMonthly    Float    @default(0)     // packagePrice + addonsTotal

  // Admin override fields
  freeCommission  Boolean  @default(false) // Exempt from commissions
  overrideNote    String?                  // Admin note for manual overrides
  overriddenBy    String?                  // Admin userId who made override

  autoRenew       Boolean  @default(true)
  cancelledAt     DateTime?
  cancelReason    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoices        Invoice[]

  @@index([userId])
  @@index([status])
  @@index([endDate])
}

// ============================================
// INVOICE MODEL
// ============================================

model Invoice {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])

  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])

  // SUBSCRIPTION | COMMISSION_BATCH | ADDON | MANUAL
  type            String   @default("SUBSCRIPTION")
  status          String   @default("PENDING") // PENDING | PAID | OVERDUE | WAIVED | PARTIALLY_PAID

  amount          Float
  amountPaid      Float    @default(0)
  currency        String   @default("DZD")

  // Billing period this invoice covers
  periodStart     DateTime?
  periodEnd       DateTime?
  dueDate         DateTime?
  paidAt          DateTime?

  // Line items: JSON array of { label, amount }
  items           String   @default("[]")  // JSON

  adminNote       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
}

// ============================================
// BILLING ADD-ON MODEL
// ============================================
model BillingAddon {
  id            String   @id @default(cuid())
  key           String   @unique
  nameAr        String
  nameEn        String
  descriptionAr String?  @db.LongText
  descriptionEn String?  @db.LongText
  price         Float    @default(0)
  isCounter     Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// DOCUMENTATION MODEL (Dynamic Docs)
// ============================================
model DocArticle {
  id          String   @id @default(cuid())
  title       String
  titleEn     String?
  slug        String   @unique
  content     String   @db.LongText
  contentEn   String?  @db.LongText
  category    String   @default("general") // general, sellers, buyers, developers
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
